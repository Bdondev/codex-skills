<mjml lang="en">
  <mj-head>
    <mj-title>CAMPAIGN_TITLE_REPLACE_ME</mj-title>
    <mj-preview>PREHEADER_REPLACE_ME</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#18231F" font-size="16px" line-height="24px" />
      <mj-button background-color="#144A38" color="#FFFFFF" font-size="16px" font-weight="bold" border-radius="4px" inner-padding="14px 22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F4F4F0" width="600px">
    <!-- Starter is intentionally generic. Replace *all* sample copy and URLs using approved campaign assets. -->
    <mj-section background-color="#FFFFFF" padding="24px">
      <mj-column>
        <mj-text align="center" font-size="20px" font-weight="bold">BRAND_NAME_REPLACE_ME</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 24px 24px">
      <mj-column>
        <mj-text padding="0" font-size="32px" line-height="38px" font-weight="bold">HEADLINE_REPLACE_ME</mj-text>
        <mj-text padding="18px 0">BODY_COPY_REPLACE_ME</mj-text>
        <mj-button href="https://example.com/replace-me" align="left" padding="10px 0">CTA_LABEL_REPLACE_ME</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#E8EDE6" padding="20px 24px">
      <mj-column>
        <mj-text padding="0" font-size="12px" line-height="18px" align="center">LEGAL_ADDRESS_REPLACE_ME</mj-text>
        <mj-text padding="8px 0 0" font-size="12px" align="center">
          <a href="https://example.com/unsubscribe-replace-me" style="color:#144A38">UNSUBSCRIBE_LINK_REPLACE_ME</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
